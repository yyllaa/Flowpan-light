{
  "schema_version": 1,
  "id": "music-scraper",
  "version": "1.0.0",
  "min_host_version": "1",
  "name": "音乐刮削",
  "description": "本地与网盘音乐标签、封面、歌词；增量处理、定时刮削与备份恢复。",
  "category": "媒体工具",
  "config_schema_version": 1,
  "data_schema_version": 1,
  "runtime": {
    "kind": "wasm",
    "module": "plugin.wasm"
  },
  "package": {
    "local": true
  },
  "permissions": [
    "host.read",
    "files.read",
    "files.publish",
    "media.read",
    "media.process",
    "artifacts.read",
    "artifacts.write",
    "accounts.read",
    "data.read",
    "data.write",
    "task.progress",
    "log.write",
    "notification.send",
    "schedule",
    "http.fetch"
  ],
  "definition": {
    "schema_version": 2,
    "api_version": "1",
    "id": "music-scraper",
    "version": "1.0.0",
    "name": "音乐刮削",
    "description": "本地与网盘音乐标签、封面、歌词；增量处理、定时刮削与备份恢复。",
    "category": "媒体工具",
    "icon": "music",
    "runtime": "wasm",
    "config_version": 1,
    "permissions": [
      "host.read",
      "files.read",
      "files.publish",
      "media.read",
      "media.process",
      "artifacts.read",
      "artifacts.write",
      "accounts.read",
      "data.read",
      "data.write",
      "task.progress",
      "log.write",
      "notification.send",
      "schedule",
      "http.fetch"
    ],
    "fields": [
      {
        "key": "account",
        "label": "音乐来源（选择一个）",
        "type": "account-list",
        "required": true,
        "hint": "选择一个已授权账号；本地目录请选择本机目录。"
      },
      {
        "key": "directory",
        "label": "音乐目录",
        "type": "path",
        "required": true,
        "hint": "本地填写完整目录；网盘填写音乐文件夹 ID，支持递归。"
      },
      {
        "key": "source",
        "label": "首选音源",
        "type": "select",
        "default": "auto",
        "options": [
          {
            "value": "auto",
            "label": "网易 → QQ → iTunes"
          },
          {
            "value": "netease",
            "label": "网易云音乐"
          },
          {
            "value": "qq",
            "label": "QQ 音乐"
          },
          {
            "value": "itunes",
            "label": "iTunes"
          },
          {
            "value": "musicbrainz",
            "label": "MusicBrainz"
          }
        ]
      },
      {
        "key": "mode",
        "label": "标签策略",
        "type": "select",
        "default": "missing",
        "options": [
          {
            "value": "missing",
            "label": "补充缺失标签"
          },
          {
            "value": "refresh",
            "label": "更新已确认标签"
          }
        ]
      },
      {
        "key": "conflict",
        "label": "写入方式",
        "type": "select",
        "default": "keep_both",
        "options": [
          {
            "value": "keep_both",
            "label": "保留原件，输出副本"
          },
          {
            "value": "replace",
            "label": "备份原件后替换（网盘）"
          }
        ],
        "hint": "备份会保留在网盘，可从刮削记录恢复。文件 ID 会变化。"
      },
      {
        "key": "filename_template",
        "label": "文件名提取模板",
        "type": "text",
        "default": "@2 - @1",
        "hint": "复用原模板引擎，@1 标题、@2 艺术家、@3 专辑；只补充文件内缺失信息。"
      },
      {
        "key": "cover",
        "label": "补充封面",
        "type": "boolean",
        "default": true
      },
      {
        "key": "lyrics",
        "label": "补充歌词",
        "type": "boolean",
        "default": true
      },
      {
        "key": "interval",
        "label": "网盘操作间隔（秒）",
        "type": "number",
        "default": 3,
        "min": 2,
        "max": 60
      },
      {
        "key": "scheduled",
        "label": "启用定时刮削",
        "type": "boolean",
        "default": false
      },
      {
        "key": "cron",
        "label": "定时规则",
        "type": "cron",
        "default": "0 0 3 * * *",
        "visible_when": {
          "field": "scheduled",
          "equals": true
        }
      }
    ],
    "actions": [
      {
        "id": "start",
        "label": "开始刮削",
        "kind": "run",
        "placement": "tools",
        "continuable": true,
        "cancellable": true,
        "requires_enabled": true,
        "timeout_seconds": 120,
        "danger": true,
        "confirmation": "按已保存的写入方式处理音乐；副本保留原件，网盘替换保留备份。确认开始？"
      },
      {
        "id": "resume",
        "label": "继续刮削",
        "kind": "run",
        "placement": "tools",
        "continuable": true,
        "cancellable": true,
        "requires_enabled": true,
        "timeout_seconds": 120,
        "danger": true,
        "confirmation": "按已保存的写入方式处理音乐；副本保留原件，网盘替换保留备份。确认开始？"
      },
      {
        "id": "status",
        "label": "刮削状态",
        "kind": "probe",
        "idempotent": true,
        "history_only": true,
        "placement": "context"
      },
      {
        "id": "records",
        "label": "刮削记录",
        "kind": "probe",
        "idempotent": true,
        "history_only": true,
        "placement": "context",
        "input_fields": [
          {
            "key": "offset",
            "label": "起始位置",
            "type": "number",
            "default": 0,
            "min": 0
          }
        ]
      },
      {
        "id": "review",
        "label": "确认匹配",
        "kind": "run",
        "continuable": true,
        "cancellable": true,
        "placement": "context",
        "danger": true,
        "confirmation": "使用选中的音乐条目继续刮削？",
        "input_fields": [
          {
            "key": "index",
            "label": "文件序号",
            "type": "number",
            "required": true
          },
          {
            "key": "candidate",
            "label": "候选序号",
            "type": "number",
            "required": true
          }
        ]
      },
      {
        "id": "restore",
        "label": "恢复原件",
        "kind": "run",
        "placement": "tools",
        "danger": true,
        "confirmation": "恢复所选记录的原始文件，并保留刮削结果？",
        "input_fields": [
          {
            "key": "publish_id",
            "label": "回写任务 ID",
            "type": "text",
            "required": true
          }
        ],
        "continuable": true,
        "cancellable": true
      }
    ],
    "http_hosts": [
      "music.163.com",
      "p1.music.126.net",
      "p2.music.126.net",
      "p3.music.126.net",
      "p4.music.126.net",
      "u.y.qq.com",
      "c.y.qq.com",
      "y.qq.com",
      "itunes.apple.com",
      "is1-ssl.mzstatic.com",
      "is2-ssl.mzstatic.com",
      "is3-ssl.mzstatic.com",
      "is4-ssl.mzstatic.com",
      "is5-ssl.mzstatic.com",
      "musicbrainz.org",
      "y.gtimg.cn"
    ],
    "network": {
      "proxy": "inherit"
    },
    "schedules": [
      {
        "id": "music",
        "label": "定时音乐刮削",
        "action": "start",
        "cron_field": "cron",
        "enabled_field": "scheduled",
        "catch_up": false
      }
    ],
    "pages": [
      {
        "id": "library",
        "label": "音乐刮削",
        "icon": "music",
        "navigation": true,
        "entry": "ui/index.html"
      }
    ]
  },
  "release": {
    "notes": "首版：本地/网盘增量刮削，串行暂存与无损封装，封面歌词，低置信度确认，定时、断点继续、云盘备份恢复。需要支持 continuation_seconds 与 media_artwork_bytes 的新版宿主。"
  }
}
