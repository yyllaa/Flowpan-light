{
  "schema_version": 1,
  "id": "storage-openlist",
  "version": "0.1.1",
  "name": "OpenList",
  "description": "将 OpenList 及其挂载的存储接入账号中心、文件浏览、播放、STRM、有声书、整理、上传和 FUSE。",
  "category": "网盘",
  "config_schema_version": 1,
  "data_schema_version": 1,
  "runtime": {
    "kind": "wasm",
    "module": "plugin.wasm"
  },
  "package": {
    "local": true
  },
  "permissions": [
    "storage.provider",
    "http.fetch",
    "data.read",
    "data.write"
  ],
  "requires": {
    "api_version": "1",
    "features": {
      "manifest.requirements": 1,
      "storage.account-endpoint": 1,
      "storage.path-refs": 1
    },
    "tools": [
      "http.fetch",
      "storage.paths",
      "kv.get",
      "kv.set"
    ]
  },
  "definition": {
    "schema_version": 2,
    "api_version": "1",
    "id": "storage-openlist",
    "version": "0.1.1",
    "name": "OpenList",
    "description": "将 OpenList 及其挂载的存储接入账号中心、文件浏览、播放、STRM、有声书、整理、上传和 FUSE。",
    "category": "网盘",
    "icon": "folder",
    "runtime": "wasm",
    "config_version": 1,
    "permissions": [
      "storage.provider",
      "http.fetch",
      "data.read",
      "data.write"
    ],
    "network": {
      "proxy": "direct"
    },
    "actions": [],
    "storage": {
      "id": "openlist",
      "name": "OpenList",
      "icon": "folder",
      "endpoint_field": "endpoint",
      "login_methods": [
        "credentials"
      ],
      "fields": [
        {
          "key": "endpoint",
          "label": "服务地址",
          "type": "url",
          "required": true,
          "hint": "OpenList 服务地址，支持 HTTP、HTTPS 和反代路径前缀。"
        },
        {
          "key": "auth_mode",
          "label": "认证方式",
          "type": "select",
          "default": "password",
          "options": [
            {
              "value": "password",
              "label": "账号密码"
            },
            {
              "value": "token",
              "label": "Token"
            }
          ]
        },
        {
          "key": "username",
          "label": "用户名",
          "type": "text",
          "required": true,
          "visible_when": {
            "field": "auth_mode",
            "equals": "password"
          }
        },
        {
          "key": "password",
          "label": "密码",
          "type": "secret",
          "required": true,
          "visible_when": {
            "field": "auth_mode",
            "equals": "password"
          }
        },
        {
          "key": "otp_code",
          "label": "两步验证码",
          "type": "secret",
          "visible_when": {
            "field": "auth_mode",
            "equals": "password"
          },
          "hint": "仅本次登录使用，启用两步验证时填写。"
        },
        {
          "key": "token",
          "label": "Token",
          "type": "secret",
          "required": true,
          "visible_when": {
            "field": "auth_mode",
            "equals": "token"
          }
        },
        {
          "key": "root",
          "label": "根目录",
          "type": "text",
          "default": "/",
          "hint": "相对于 OpenList 用户目录，例如 /影视。"
        },
        {
          "key": "directory_password",
          "label": "目录密码",
          "type": "secret"
        }
      ],
      "capabilities": [
        "list",
        "stat",
        "read",
        "link",
        "mkdir",
        "rename",
        "move",
        "copy",
        "delete",
        "upload",
        "refresh"
      ]
    }
  },
  "release": {
    "title": "OpenList 0.1.1",
    "notes": "修复未开启代理的存储下载返回 403：下载和播放改用 OpenList 下载入口，沿用存储自身的直链或代理设置，保留签名、Range 读取及账号隔离。"
  }
}
