      },
      "package": {
        "url": "https://github.com/yyllaa/Flowpan-light/releases/download/plugins-2026.11.06/resource-dian-1.1.1.zip",
        "sha256": "9fee52d8756739ff3afb154ac8b696c03dcb887dd1b9e3be39b96f2d280e66c1",
