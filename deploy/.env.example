# Replace with the exact tag printed by docker load (Loaded image: ...).
# This example is a local image tag, not a public registry address.
FLOWPAN_IMAGE=flowpan-light-core:installed

TZ=Asia/Shanghai
FLOWPAN_WEB_PORT=8080
FLOWPAN_EMBY_PORT=8081
FLOWPAN_FNTV_PORT=8082

# Optional Linux FUSE overlay: absolute path to a prepared shared host directory.
# FLOWPAN_CLOUD_DIR=/srv/flowpan/cloud
